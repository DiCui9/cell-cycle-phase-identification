import os
import shutil
import sys

def organize_training_data(base_path, output_path):
    # Ensure the output path exists
    if not os.path.exists(output_path):
        os.makedirs(output_path)

    # Define the subdirectories to look for
    subdirs = ["train", "valid", "test"]
    
    for subdir in subdirs:
        gt_folder = os.path.join(base_path, subdir, "gt")
        
        if not os.path.exists(gt_folder):
            print(f"Missing gt folder for {subdir}")
            continue
        
        for file_name in os.listdir(gt_folder):
            if file_name.startswith("aug") or not file_name.endswith(".tif"):
                continue
            
            # Extract location and zone from the file name
            parts = file_name.split('_')
            if len(parts) < 3:
                print(f"Unexpected file name format: {file_name}")
                continue

            location = parts[1]  # e.g., B02
            zone = parts[2]  # e.g., s1
            location_zone = f"{location}_{zone}"

            # Define the new folder structure
            new_folder = os.path.join(output_path, location_zone)
            if not os.path.exists(new_folder):
                os.makedirs(new_folder)

            # Copy the file to the new folder
            src_path = os.path.join(gt_folder, file_name)
            dst_path = os.path.join(new_folder, file_name)
            shutil.copy2(src_path, dst_path)
            print(f"Copied {src_path} to {dst_path}")

def main():
    if len(sys.argv) != 3:
        print("Usage: python organize_training_data.py <base_path> <output_path>")
        sys.exit(1)

    base_path = sys.argv[1]
    output_path = sys.argv[2]

    organize_training_data(base_path, output_path)

if __name__ == "__main__":
    main()
